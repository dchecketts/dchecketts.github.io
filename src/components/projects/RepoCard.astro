---
interface Props {
  url: string;
  name: string;
  desc?: string;
  lang?: string;
}

const {
  url = '/',
  name = 'Repository',
  desc = 'No description available.',
  lang = 'N/A',
} = Astro.props;
---

<li
  class="mx-auto mb-2 flex w-9/10 items-center rounded-md bg-white shadow-sm transition hover:bg-gray-50 md:max-w-7/10 md:min-w-8/10 dark:bg-slate-700 dark:hover:bg-slate-500"
>
  <a href={url} target="_blank" rel="noopener noreferrer" class="block w-full p-5">
    <div>
      <h2 class="text-center text-2xl font-semibold text-slate-800 dark:text-slate-300">{name}</h2>
      <div
        class="mt-2 flex flex-col items-center justify-between gap-3 px-5 text-slate-600 md:flex-row dark:text-slate-200"
      >
        <span class="text-justify md:max-w-2/3">{desc}</span>
        <span class="text-sm font-medium">Language: {lang}</span>
      </div>
    </div>
  </a>
</li>
