---
import { Octokit } from 'octokit';
import RepoCard from './RepoCard.astro';

class GitHubProject {
  name: string;
  description: string | null;
  url: string;
  homepage: string | null;
  stars: number;
  language: string | null;
  pushedAt: string;

  constructor(repoData: any) {
    this.name = repoData.name;
    this.description = repoData.description;
    this.url = repoData.html_url;
    this.homepage = repoData.homepage;
    this.stars = repoData.stargazers_count;
    this.language = repoData.language;
    this.pushedAt = repoData.pushed_at;
  }
}

const octokit = new Octokit({});
const GITHUB_USERNAME = 'dchecketts';

function toTitleCase(slug: string): string {
  return slug
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

let filteredProjects: GitHubProject[] = [];

try {
  const response = await octokit.request('GET /users/{username}/repos', {
    username: GITHUB_USERNAME,
    type: 'owner',
    per_page: 30,
  });

  const projects = response.data.map((repo: any) => new GitHubProject(repo));

  projects.sort((a, b) => Date.parse(b.pushedAt) - Date.parse(a.pushedAt));

  const blockedKeywords = [
    GITHUB_USERNAME,
    'hw',
    'society',
    'racing',
    'translation',
    'learn',
    'cloudflare',
    'portfolio',
  ];
  filteredProjects = projects
    .filter((p) => !blockedKeywords.some((word) => p.name.toLowerCase().includes(word)))
    .slice(0, 6);
} catch (error) {
  console.error('Error fetching projects during Astro build phase:', error);
}
---

<section class="rounded-lg bg-gray-100 px-10 py-5 md:w-2/3 dark:bg-gray-900">
  <h2 class="mx-auto max-w-fit text-3xl">My Recent Projects</h2>

  <ul class="flex flex-col gap-2 py-4" id="projects-list">
    {
      filteredProjects.map((project) => (
        <RepoCard
          url={project.url}
          name={toTitleCase(project.name)}
          desc={project.description}
          lang={project.language}
        />
      ))
    }
    {
      filteredProjects.length === 0 && (
        <li class="p-5 text-center text-gray-500 dark:text-gray-300">No repositories available.</li>
      )
    }
  </ul>
</section>
