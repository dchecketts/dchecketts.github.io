---
import Link from '../link.astro';

interface ContactItem {
  label: string;
  href: string | undefined;
  type: string | undefined;
  external?: boolean | false;
}

const year = new Date().getFullYear();
const _linkItem =
  'text-sm text-emerald-100 underline-offset-4 transition-colors hover:text-white hover:underline focus-visible:outline-white';

const contactItems: ContactItem[] = [
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/manny.checketts',
    type: 'footer',
    external: true,
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/daniel-checketts',
    type: 'footer',
    external: true,
  },
  { label: 'GitHub', href: 'https://www.github.com/dchecketts', type: 'footer', external: true },
];
---

<footer class="border-t border-emerald-950/20 bg-emerald-950 text-white">
  <div
    class="site-container flex flex-col gap-4 px-20 py-6 md:flex-row md:items-center md:justify-between"
  >
    <p class="text-sm text-emerald-100">&copy; {year} Daniel Checketts. All rights reserved.</p>

    <nav aria-label="Footer links">
      <ul class="flex flex-wrap gap-4">
        {
          contactItems.map((item: ContactItem) => (
            <li>
              <Link url={item.href} type={item.type} external={item.external}>
                {item.label}
              </Link>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
