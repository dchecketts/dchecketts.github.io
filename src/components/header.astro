---
import Link from '../components/mdx/Link.astro';
---

<header
  class="sticky top-0 z-50 flex items-center justify-between border-b border-emerald-950/20 bg-emerald-900 py-4 text-white shadow-sm"
>
  <div class="site-container">
    <a href="/" class="text-lg font-semibold tracking-tight text-white hover:text-emerald-100">
      Daniel Checketts
    </a>

    <nav aria-label="Main navigation">
      <ul class="flex items-center gap-6">
        <li><Link url="/now" type="header">Now</Link></li>
        <li><Link url="/learn" type="header">Learn</Link></li>
        <li><Link url="/blog" type="header">Blog</Link></li>
      </ul>
    </nav>
  </div>
</header>
