---
import BaseLayout from '../layouts/baselayout.astro';
import RepoList from '../components/projects/RepoList.astro';
import profilePicture from '../assets/images/daniel-checketts-2025.jpg';
import { Image } from 'astro:assets';
---

<BaseLayout>
  <div class="flex flex-col gap-5 px-5 py-10 md:flex-row md:px-20">
    <section
      class="flex flex-col rounded-lg bg-white px-5 py-10 md:w-1/3 dark:bg-gray-900 dark:text-gray-200"
      id="bio"
    >
      <div class="my-auto">
        <div class="flex flex-col items-center gap-2">
          <Image
            src={profilePicture}
            alt="Daniel Checketts"
            class="aspect-square size-64 rounded-full object-cover"
            loading="eager"
          />
          <span class="text-gray-400">Me, Circa Late 2025</span>
        </div>

        <section class="flex flex-col items-center justify-center gap-2 p-5">
          <h1 class="mx-auto text-5xl font-bold">Welcome!</h1>
          <span class="mb-3 text-center text-3xl"
            >Hi, my name is Daniel Checketts, and I love writing code.</span
          >
          <a
            class="mx-auto w-fit rounded-full bg-emerald-600 px-4 py-2 text-center text-white hover:bg-emerald-700"
            href="/learn">Start Learning</a
          >
        </section>
      </div>
    </section>

    <RepoList />
  </div>
</BaseLayout>
